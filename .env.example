APP_NAME=ReliAI
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DATABASE_URL=postgresql+psycopg://reli:reli_local_only@db:5432/reli
LLM_PROVIDER=mock
# Inactive in the frontend. Retained for backend compatibility only.
TOGETHER_API_KEY=
# Together AI model setting; Together provider is currently inactive.
TOGETHER_MODEL=Qwen/Qwen3.5-9B
# Optional. Required only when LLM_PROVIDER=groq or Groq is selected in the UI.
GROQ_API_KEY=
# Groq hosted model. Override this with another supported model ID.
GROQ_MODEL=openai/gpt-oss-20b
# Dataset import limits: 20 MiB, 10,000 rows, 500 inserted cases per batch.
DATASET_IMPORT_MAX_BYTES=20971520
DATASET_IMPORT_MAX_CASES=10000
DATASET_IMPORT_BATCH_SIZE=500
# Explicit public DNS host and exact endpoint allowlists for project integrations.
PROJECT_ALLOWED_HOSTS=
PROJECT_ALLOWED_ENDPOINTS=
# Exact private HTTP endpoints are only enabled for the shared KnowledgeOps Docker network.
KNOWLEDGEOPS_DOCKER_NETWORK=knowledgeops_default
PROJECT_ALLOWED_LOCAL_DOCKER_ENDPOINTS=http://knowledgeops-backend-1:8000/ask
PROJECT_LOCAL_DOCKER_NETWORK_CIDR=172.18.0.0/16
# Optional credential labels and JSON mapping of labels to secrets (backend-only).
PROJECT_AUTH_ENV_VARS=
PROJECT_AUTH_TOKENS_JSON=
PROJECT_HTTP_TIMEOUT_SECONDS=20
PROJECT_MAX_CONCURRENCY=8
PROJECT_REQUESTS_PER_SECOND=5
PROJECT_MAX_RETRIES=1
POSTGRES_DB=reli
POSTGRES_USER=reli
POSTGRES_PASSWORD=reli_local_only
